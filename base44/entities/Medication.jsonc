{
  "name": "Medication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Medication Name"
    },
    "dosage": {
      "type": "string",
      "title": "Dosage"
    },
    "frequency": {
      "type": "string",
      "title": "Frequency"
    },
    "is_critical_alert": {
      "type": "boolean",
      "title": "Critical Alert",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}