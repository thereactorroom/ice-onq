{
  "name": "ChronicCondition",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "title": "Profile ID"
    },
    "name": {
      "type": "string",
      "title": "Condition Name"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_critical_alert": {
      "type": "boolean",
      "title": "Critical Alert",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}